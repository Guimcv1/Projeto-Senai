<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SCA.Views.PainelVisaoGeralView">

	<Grid>
		<StackPanel>
			<TextBlock FontSize="40" Foreground="#002776" Margin="0,0,0,20" FontWeight="Bold">Gestão de Ambientes</TextBlock>

			<Border Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
				<StackPanel Orientation="Horizontal">
					<StackPanel Margin="0,0,20,0">
						<TextBlock Foreground="#64748B" FontSize="14" FontWeight="SemiBold" Margin="0,0,0,8">Pesquisar Sala</TextBlock>
						<StackPanel Orientation="Horizontal">
							<material:MaterialIcon Kind="Magnify" Width="24" Height="24" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,10,0"/>
							<AutoCompleteBox x:Name="txtSearch" Width="300" FontSize="16" Watermark="Ex: Sala 101" TextChanged="Search_TextChanged" FilterMode="Custom"/>
						</StackPanel>
					</StackPanel>
				</StackPanel>
			</Border>

			<Border Background="White" CornerRadius="8" Padding="15,20" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
				<StackPanel Orientation="Horizontal">
					<StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
						<Ellipse Width="12" Height="12" Fill="#16a34a"/>
						<TextBlock Text="Todos disponíveis" Margin="8,0,0,0" FontSize="14" Foreground="#64748b" FontWeight="Medium"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
						<Ellipse Width="12" Height="12" Fill="#ea580c"/>
						<TextBlock Text="Parcialmente ocupado" Margin="8,0,0,0" FontSize="14" Foreground="#64748b" FontWeight="Medium"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" Margin="0,0,20,0" VerticalAlignment="Center">
						<Ellipse Width="12" Height="12" Fill="#dc2626"/>
						<TextBlock Text="Todos emprestados" Margin="8,0,0,0" FontSize="14" Foreground="#64748b" FontWeight="Medium"/>
					</StackPanel>
					<StackPanel Orientation="Horizontal" VerticalAlignment="Center">
						<Ellipse Width="12" Height="12" Fill="#94a3b8"/>
						<TextBlock Text="Indisponível / Aguardando" Margin="8,0,0,0" FontSize="14" Foreground="#64748b" FontWeight="Medium"/>
					</StackPanel>
				</StackPanel>
			</Border>

			<ScrollViewer VerticalScrollBarVisibility="Auto" Height="500">
				<ItemsControl x:Name="icAmbientes">
					<ItemsControl.ItemsPanel>
						<ItemsPanelTemplate>
							<WrapPanel Orientation="Horizontal" />
						</ItemsPanelTemplate>
					</ItemsControl.ItemsPanel>

					<ItemsControl.ItemTemplate>
						<DataTemplate>
							<Border Width="220" Height="120" Margin="0,0,20,20" CornerRadius="12" Background="{Binding CorStatus}" Cursor="Hand" PointerPressed="RoomCard_Click">
								<Grid>
									<TextBlock Text="{Binding Nome}" FontSize="18" FontWeight="Bold" Foreground="White"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               TextWrapping="Wrap" TextAlignment="Center" Margin="15"/>
								</Grid>
							</Border>
						</DataTemplate>
					</ItemsControl.ItemTemplate>
				</ItemsControl>
			</ScrollViewer>
		</StackPanel>

		<!-- Room Items "Dialog" Overlay -->
		<Border x:Name="RoomDialogOverlay" IsVisible="False" Background="#80000000">
			<Border Background="White" CornerRadius="12" Width="600" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
				<Grid RowDefinitions="Auto,Auto,*,Auto">
					<Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,15">
						<TextBlock x:Name="txtDialogTitle" FontSize="20" FontWeight="Bold" Foreground="#002776" Text="Detalhes do Ambiente"/>
						<Button Grid.Column="1" Background="Transparent" BorderThickness="0" Click="CloseDialog_Click" Foreground="#64748b" Padding="0" Height="30" Width="30">
							<material:MaterialIcon Kind="Close" Width="20" Height="20"/>
						</Button>
					</Grid>

					<TextBlock Grid.Row="1" Foreground="#64748B" FontSize="14" Margin="0,0,0,15">Selecione os itens que deseja solicitar ou devolver.</TextBlock>

					<Border Grid.Row="2" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="8" MaxHeight="300">
						<DataGrid x:Name="dgItems" AutoGenerateColumns="False" IsReadOnly="False" Background="White" BorderThickness="0">
							<DataGrid.Columns>
								<DataGridTemplateColumn Width="80">
									<DataGridTemplateColumn.Header>
										<CheckBox x:Name="chkSelectAll" Content="Todos" Margin="10,0,0,0" VerticalAlignment="Center" Click="ChkSelectAll_Click"/>
									</DataGridTemplateColumn.Header>
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center" IsEnabled="{Binding CanSelect}"/>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
								<DataGridTextColumn Header="Ativo / Item" Binding="{Binding Descricao}" Width="*" IsReadOnly="True"/>
								<DataGridTextColumn Header="Quem Pegou / Reservou" Binding="{Binding QuemPegou}" Width="*" IsReadOnly="True"/>
								<DataGridTemplateColumn Header="Situação Atual" Width="150">
									<DataGridTemplateColumn.CellTemplate>
										<DataTemplate>
											<Border Background="{Binding BadgeColor}" CornerRadius="12" Padding="8,4" HorizontalAlignment="Left" Margin="5">
												<TextBlock Text="{Binding BadgeText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
											</Border>
										</DataTemplate>
									</DataGridTemplateColumn.CellTemplate>
								</DataGridTemplateColumn>
							</DataGrid.Columns>
						</DataGrid>
					</Border>

					<Grid Grid.Row="3" ColumnDefinitions="Auto,*,Auto" Margin="0,20,0,0">
						<Button Grid.Column="0" Content="Cancelar Operação" Click="CloseDialog_Click"/>
						<StackPanel Grid.Column="2" Orientation="Horizontal">
							<Button Background="#EA580C" Foreground="White" Content="Devolver Todos os Itens" Click="DevolverTodos_Click" Margin="0,0,10,0"/>
							<Button x:Name="btnProcessSelected" Background="#16A34A" Foreground="White" Content="Processar Selecionados" Click="ProcessSelectedItems_Click"/>
						</StackPanel>
					</Grid>
				</Grid>
			</Border>
		</Border>

		<!-- Loan Request Login Dialog -->
		<Border x:Name="LoginDialogOverlay" IsVisible="False" Background="#80000000" ZIndex="110">
			<Border Background="White" CornerRadius="12" Width="400" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="30">
				<StackPanel>
					<TextBlock x:Name="txtLoginDialogTitle" Text="Identificação Necessária" FontSize="20" FontWeight="Bold" Foreground="#002776" Margin="0,0,0,10"/>
					<TextBlock x:Name="txtLoginDialogSubtitle" Text="Por favor, informe suas credenciais para solicitar os itens." Foreground="#64748B" FontSize="14" Margin="0,0,0,20" TextWrapping="Wrap"/>

					<TextBlock Text="Login" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
					<TextBox x:Name="txtRequestLogin" Margin="0,0,0,15" Watermark="Seu login"/>

					<TextBlock Text="Senha" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
					<TextBox x:Name="txtRequestPassword" PasswordChar="*" Margin="0,0,0,25" Watermark="Sua senha">
						<TextBox.InnerRightContent>
							<Button Background="Transparent" BorderThickness="0" Width="30" Height="30" Click="ToggleRequestPasswordVisibility_Click">
								<material:MaterialIcon x:Name="iconRequestPasswordVisibility" Kind="EyeOff" Width="20" Height="20" Foreground="#64748B"/>
							</Button>
						</TextBox.InnerRightContent>
					</TextBox>

					<Grid ColumnDefinitions="*,*">
						<Button Grid.Column="0" Content="Cancelar" HorizontalAlignment="Left" Click="CloseLoginDialog_Click"/>
						<Button x:Name="btnConfirmLoanRequest" Grid.Column="1" Content="Confirmar" HorizontalAlignment="Right" Background="#16A34A" Foreground="White" Click="ConfirmLoanRequest_Click"/>
					</Grid>
				</StackPanel>
			</Border>
		</Border>
	</Grid>
</UserControl>