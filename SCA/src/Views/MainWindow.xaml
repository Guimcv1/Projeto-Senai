<Window x:Class="SCA.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:materialDesign="http://materialdesigninxaml.net/winfx/xaml/themes"
        Title="Controlo de Ambientes | SENAI" Height="1080" Width="1920" WindowStartupLocation="CenterScreen">
    
    <materialDesign:DialogHost Identifier="RootDialog">
        <Grid Background="#F1F5F9">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="250"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <Border Grid.Column="0" Background="#002776">
                <StackPanel>
                    <Border Background="White" Height="100" Padding="15">
                        <Image Source="pack://application:,,,/assets/senai_logo.png" Stretch="Uniform"/>
                    </Border>
                    <Border Height="4" Background="#EA580C"/>

                    <Button x:Name="btnVisaoGeral" Background="#26FFFFFF" BorderBrush="#EA580C" BorderThickness="4,0,0,0" Foreground="White" Margin="0,20,0,0" HorizontalContentAlignment="Left" Padding="20,15" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ViewDashboard" Width="24" Height="24" Margin="0,0,10,0"/>
                            <TextBlock FontSize="16" VerticalAlignment="Center">Visão Geral</TextBlock>
                        </StackPanel>
                    </Button>
                    
                    <Button x:Name="btnAprovacoes" Visibility="Collapsed" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,15" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="CheckAll" Width="24" Height="24" Margin="0,0,10,0"/>
                            <TextBlock FontSize="16" VerticalAlignment="Center">Aprovações</TextBlock>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnLocais" Visibility="Collapsed" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,15" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="MapMarker" Width="24" Height="24" Margin="0,0,10,0"/>
                            <TextBlock FontSize="16" VerticalAlignment="Center">Gerir Locais</TextBlock>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnItens" Visibility="Collapsed" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,15" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="PackageVariant" Width="24" Height="24" Margin="0,0,10,0"/>
                            <TextBlock FontSize="16" VerticalAlignment="Center">Gerir Itens</TextBlock>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnUsuarios" Visibility="Collapsed" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,15" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="AccountMultiple" Width="24" Height="24" Margin="0,0,10,0"/>
                            <TextBlock FontSize="16" VerticalAlignment="Center">Gerir Utilizadores</TextBlock>
                        </StackPanel>
                    </Button>

                    <Button x:Name="btnRelatorios" Visibility="Collapsed" Background="Transparent" Foreground="White" BorderThickness="0" HorizontalContentAlignment="Left" Padding="20,15" Click="MenuButton_Click">
                        <StackPanel Orientation="Horizontal">
                            <materialDesign:PackIcon Kind="ChartBar" Width="24" Height="24" Margin="0,0,10,0"/>
                            <TextBlock FontSize="16" VerticalAlignment="Center">Relatórios e Logs</TextBlock>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Border>

            <!-- Main Content Area -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Grid.Row="0" Background="White" Height="80" BorderBrush="#EA580C" BorderThickness="0,0,0,4" Padding="20,0">
                    <Grid>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <Border x:Name="UserBadge" Background="#F1F5F9" BorderBrush="#E2E8F0" BorderThickness="1" CornerRadius="20" Padding="15,8" Margin="0,0,20,0" Visibility="Collapsed">
                                <TextBlock x:Name="txtUserNameDisplay" Foreground="#002776" FontWeight="SemiBold">Sessão: Admin</TextBlock>
                            </Border>
                            <Button x:Name="btnAuth" Height="45" Padding="15,0"
                                    Background="Transparent" Foreground="#002776" BorderThickness="2" BorderBrush="#002776"
                                    Style="{StaticResource MaterialDesignFlatButton}" Click="BtnAuth_Click">
                                <StackPanel Orientation="Horizontal">
                                    <materialDesign:PackIcon x:Name="iconAuth" Kind="AccountLock" Width="20" Height="20" VerticalAlignment="Center" Margin="0,0,10,0"/>
                                    <TextBlock x:Name="txtAuth" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">Acesso Administrativo</TextBlock>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Page Content -->
                <ContentControl x:Name="MainContent" Grid.Row="1" Margin="30"/>
            </Grid>
        </Grid>
    </materialDesign:DialogHost>
</Window>
