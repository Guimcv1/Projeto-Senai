<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SCA.Views.UsuariosView">
    <Grid>
        <Grid RowDefinitions="Auto,Auto,*">
            <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,20">
                <TextBlock Grid.Column="0" FontSize="40" Foreground="#002776" VerticalAlignment="Center" FontWeight="Bold">Gerir Utilizadores</TextBlock>
                <Button Grid.Column="1" Background="#EA580C" Foreground="White" Height="45" Padding="20,0" Click="NovoUsuario_Click">
                    <StackPanel Orientation="Horizontal">
                        <material:MaterialIcon Kind="AccountPlus" Width="24" Height="24" Margin="0,0,10,0"/>
                        <TextBlock FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center">Novo Utilizador</TextBlock>
                    </StackPanel>
                </Button>
            </Grid>

            <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Foreground="#64748B" FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center">Pesquisar:</TextBlock>
                    <material:MaterialIcon Kind="Magnify" Width="24" Height="24" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,10,0"/>
                    <AutoCompleteBox x:Name="txtSearch" Width="300" FontSize="16" Watermark="Buscar nome ou login..." TextChanged="Search_TextChanged" FilterMode="Custom"/>
					<Button Margin="8,0,0,0" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="ClearSearch_Click" ToolTip.Tip="Limpar busca">
						<material:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="#64748B"/>
					</Button>
                </StackPanel>
            </Border>
            
            <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="24" BorderBrush="#E2E8F0" BorderThickness="1">
                <Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <DataGrid x:Name="dgUsuarios" AutoGenerateColumns="False" IsReadOnly="True" Background="White" BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="50" MinHeight="400">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="ID" Binding="{Binding Id}" Width="80"/>
                            <DataGridTextColumn Header="Nome" Binding="{Binding Nome}" Width="*"/>
                            <DataGridTextColumn Header="Login" Binding="{Binding Login}" Width="*"/>
                            <DataGridTextColumn Header="Perfil" Binding="{Binding Perfil}" Width="120"/>
                            <DataGridTemplateColumn Header="Status" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border Background="{Binding BadgeColor}" CornerRadius="12" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5">
                                            <TextBlock Text="{Binding StatusText}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                            <DataGridTemplateColumn Header="Ações" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="5">
                                            <Button Background="Transparent" BorderThickness="0" ToolTip.Tip="Editar" Foreground="#3B82F6" Width="35" Height="35" Click="Editar_Click">
                                                <material:MaterialIcon Kind="Pencil" Width="20" Height="20"/>
                                            </Button>
                                            <Button Background="Transparent" BorderThickness="0" ToolTip.Tip="Inativar/Ativar" Foreground="#DC2626" Width="35" Height="35" Click="Inativar_Click">
                                                <material:MaterialIcon Kind="AccountCancel" Width="20" Height="20"/>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                        </DataGrid>
                    </ScrollViewer>
                </Grid>
            </Border>
        </Grid>

        <!-- Dialog Overlay -->
        <Border x:Name="UsuarioDialogOverlay" IsVisible="False" Background="#80000000">
            <Border Background="White" CornerRadius="12" Width="500" VerticalAlignment="Center" HorizontalAlignment="Center" Padding="20">
                <Grid RowDefinitions="Auto,Auto,Auto">
                    <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,15">
                        <TextBlock x:Name="txtDialogTitle" FontSize="20" FontWeight="Bold" Foreground="#002776" Text="Novo Utilizador"/>
                        <Button Grid.Column="1" Background="Transparent" BorderThickness="0" Click="CloseDialog_Click" Foreground="#64748b" Padding="0" Height="30" Width="30">
                            <material:MaterialIcon Kind="Close" Width="20" Height="20"/>
                        </Button>
                    </Grid>

                    <StackPanel Grid.Row="1" Margin="0,0,0,20">
                        <TextBlock Text="Nome Completo" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtNome" FontSize="16" Margin="0,0,0,15"/>
                        
                        <TextBlock Text="Login de Acesso" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtLogin" FontSize="16" Margin="0,0,0,15"/>

                        <TextBlock Text="Senha" Foreground="#64748B" FontSize="12" Margin="0,0,0,5"/>
                        <TextBox x:Name="txtSenha" PasswordChar="*" FontSize="16" Margin="0,0,0,15"/>

                        <CheckBox x:Name="chkIsAdmin" Content="Administrador" Margin="0,0,0,10"/>
                        <CheckBox x:Name="chkIsAtivo" Content="Ativo" IsChecked="True"/>
                    </StackPanel>

                    <Grid Grid.Row="2" ColumnDefinitions="Auto,*">
                        <Button Grid.Column="0" Content="Cancelar" Click="CloseDialog_Click"/>
                        <Button Grid.Column="1" HorizontalAlignment="Right" Background="#16A34A" Foreground="White" Content="Salvar Utilizador" Click="Salvar_Click"/>
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>
