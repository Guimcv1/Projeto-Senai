<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:material="using:Material.Icons.Avalonia"
             mc:Ignorable="d" d:DesignWidth="1200" d:DesignHeight="800"
             x:Class="SCA.Views.AprovacoesView">
    <Grid RowDefinitions="Auto,Auto,*">
        <TextBlock Grid.Row="0" FontSize="40" Foreground="#002776" Margin="0,0,0,20" FontWeight="Bold">Aprovações Pendentes</TextBlock>
        
        <Border Grid.Row="1" Background="White" CornerRadius="8" Padding="20" Margin="0,0,0,20" BorderBrush="#E2E8F0" BorderThickness="1">
            <StackPanel Orientation="Horizontal">
                <TextBlock Foreground="#64748B" FontSize="14" FontWeight="SemiBold" Margin="0,0,10,0" VerticalAlignment="Center">Pesquisar:</TextBlock>
                <material:MaterialIcon Kind="Magnify" Width="24" Height="24" VerticalAlignment="Center" Foreground="#64748B" Margin="0,0,10,0"/>
                <TextBox x:Name="txtSearch" Width="300" FontSize="16" Watermark="Buscar item, ambiente ou solicitante..." TextChanged="Search_TextChanged"/>
				<Button Margin="8,0,0,0" Width="32" Height="32" Padding="0" Background="Transparent" BorderThickness="0" Click="ClearSearch_Click" ToolTip.Tip="Limpar busca">
					<material:MaterialIcon Kind="Close" Width="18" Height="18" Foreground="#64748B"/>
				</Button>
            </StackPanel>
        </Border>

        <Border Grid.Row="2" Background="White" CornerRadius="12" Padding="24" BorderBrush="#E2E8F0" BorderThickness="1">
            <Grid RowDefinitions="*,Auto">
                <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
                    <DataGrid x:Name="dgAprovacoes" AutoGenerateColumns="False" IsReadOnly="False" Background="White" BorderThickness="1" BorderBrush="#E2E8F0" RowHeight="50" MinHeight="300">
                    <DataGrid.Columns>
                        <DataGridTemplateColumn Width="80">
                            <DataGridTemplateColumn.Header>
                                <CheckBox x:Name="chkSelectAll" Content="Todos" Margin="10,0,0,0" VerticalAlignment="Center" Click="ChkSelectAll_Click"/>
                            </DataGridTemplateColumn.Header>
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                        <DataGridTextColumn Header="Item" Binding="{Binding DescricaoItems}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Ambiente" Binding="{Binding Ambiente}" Width="*" IsReadOnly="True"/>
                        <DataGridTextColumn Header="Solicitante" Binding="{Binding Solicitante}" Width="*" IsReadOnly="True"/>
                        <DataGridTemplateColumn Header="Ação" Width="150">
                            <DataGridTemplateColumn.CellTemplate>
                                <DataTemplate>
                                    <Border Background="{Binding BadgeColor}" CornerRadius="12" Padding="12,6" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="5">
                                        <TextBlock Text="{Binding Acao}" Foreground="White" FontSize="11" FontWeight="Bold"/>
                                    </Border>
                                </DataTemplate>
                            </DataGridTemplateColumn.CellTemplate>
                        </DataGridTemplateColumn>
                    </DataGrid.Columns>
                    </DataGrid>
                </ScrollViewer>
                
                <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,20,0,0">
                    <Button Background="#16A34A" Foreground="White" Padding="20,10" Margin="0,0,10,0" Click="Aprovar_Click">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="CheckBold" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Aprovar Selecionados"/>
                        </StackPanel>
                    </Button>
                    <Button Background="#DC2626" Foreground="White" Padding="20,10" Click="Recusar_Click">
                        <StackPanel Orientation="Horizontal">
                            <material:MaterialIcon Kind="CloseBold" Width="20" Height="20" Margin="0,0,10,0"/>
                            <TextBlock Text="Recusar Selecionados"/>
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
